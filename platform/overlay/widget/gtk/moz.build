DIRS += ["wayland", "/third_party/gbm/libgbm"]

if CONFIG["MOZ_ENABLE_VAAPI"]:
    DIRS += ["vaapitest"]

if CONFIG["MOZ_ENABLE_V4L2"]:
    DIRS += ["v4l2test"]

if CONFIG["MOZ_ENABLE_VULKAN_VIDEO"]:
    DIRS += ["vulkantest"]

EXPORTS += [
    "MozContainer.h",
    "nsAppShell.h",
    "nsGTKToolkit.h",
    "nsGtkUtils.h",
]

EXPORTS.mozilla += [
    "GfxInfo.h",
    "GfxInfoUtils.h",
    "WidgetUtilsGtk.h",
]

EXPORTS.mozilla.widget += [
    "BandeHost.h",
    "CompositorWidgetChild.h",
    "CompositorWidgetParent.h",
    "DMABufDevice.h",
    "DMABufFormats.h",
    "DMABufSurface.h",
    "GSettings.h",
    "GtkCompositorWidget.h",
    "InProcessGtkCompositorWidget.h",
    "mozwayland.h",
    "nsWaylandDisplay.h",
    "va_drmcommon.h",
    "WaylandBuffer.h",
    "WaylandSurface.h",
    "WaylandSurfaceLock.h",
    "WindowSurface.h",
    "WindowSurfaceProvider.h",
]

UNIFIED_SOURCES += [
    "BandeFdWatch.cpp",
    "BandeHost.cpp",
    "BandeKeys.cpp",
    "BandePortal.cpp",
    "BandeTimers.cpp",
    "BandeWakeLock.cpp",
    "CompositorWidgetChild.cpp",
    "CompositorWidgetParent.cpp",
    "DMABufDevice.cpp",
    "DMABufFormats.cpp",
    "GfxInfo.cpp",
    "GtkCompositorWidget.cpp",
    "InProcessGtkCompositorWidget.cpp",
    "NativeKeyBindings.cpp",
    "NativeMenuSupport.cpp",
    "nsAppShell.cpp",
    "nsBandeIdleService.cpp",
    "nsBidiKeyboard.cpp",
    "nsClipboard.cpp",
    "nsDragService.cpp",
    "nsFilePicker.cpp",
    "nsLookAndFeel.cpp",
    "nsWaylandDisplay.cpp",
    "nsWidgetFactory.cpp",
    "ScreenHelperBande.cpp",
    "WaylandBuffer.cpp",
    "WaylandSurface.cpp",
    "WaylandSurfaceLock.cpp",
    "WidgetUtilsGtk.cpp",
    "WindowSurfaceProvider.cpp",
    "WindowSurfaceWaylandMultiBuffer.cpp",
]

if CONFIG["NS_PRINTING"]:
    UNIFIED_SOURCES += [
        "nsBandePrinting.cpp",
    ]

SOURCES += [
    "DMABufSurface.cpp",
    "MediaKeysEventSourceFactory.cpp",
    "nsWindow.cpp",
    "WaylandVsyncSource.cpp",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"

LOCAL_INCLUDES += [
    "/layout/base",
    "/layout/forms",
    "/layout/generic",
    "/layout/xul",
    "/widget",
    "/widget/headless",
]

CXXFLAGS += CONFIG["MOZ_GBM_CFLAGS"]
if not CONFIG["MOZ_SYSTEM_GBM"]:
    LOCAL_INCLUDES += [
        "/third_party/gbm/gbm/",
    ]
    DIRS += [
        "/third_party/gbm/gbm/",
    ]

CXXFLAGS += CONFIG["MOZ_LIBDRM_CFLAGS"]
if not CONFIG["MOZ_SYSTEM_LIBDRM"]:
    LOCAL_INCLUDES += [
        "/third_party/drm/drm/",
        "/third_party/drm/drm/include/",
        "/third_party/drm/drm/include/libdrm",
    ]
