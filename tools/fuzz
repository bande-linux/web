#!/bin/bash
set -euo pipefail

minutes=${1:-10}
root=$(cd "$(dirname "$0")/.." && pwd)
cache=${WEB_FUZZ:-${XDG_CACHE_HOME:-$HOME/.cache}/bande-web/fuzz}
if [ -z "${BUILD_RUN_JOB:-}" ] && [ -x "$HOME/bande-linux/bin/build-run" ]; then
    mkdir -p "$cache"
    BUILD_EXTRA_DIRS=$cache BUILD_FETCH=$cache exec "$HOME/bande-linux/bin/build-run" "$root" tools/fuzz "$@"
fi
export CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-$root/target}/fuzz

targets=()
for manifest in "$root"/crates/*/fuzz/Cargo.toml; do
    [ -e "$manifest" ] || continue
    dir=$(dirname "$manifest")
    (cd "$dir" && cargo fuzz build --sanitizer none)
    for target in $(cd "$dir" && cargo fuzz list); do
        targets+=("$dir:$target")
    done
done
if [ ${#targets[@]} -eq 0 ]; then
    echo "no fuzz targets"
    exit 0
fi

seconds=$((minutes * 60 / ${#targets[@]}))
seconds=$((seconds < 10 ? 10 : seconds))
failed=()
for entry in "${targets[@]}"; do
    dir=${entry%%:*}
    target=${entry#*:}
    crate=$(basename "$(dirname "$dir")")
    store=$cache/$crate/$target
    mkdir -p "$store/corpus" "$store/artifacts"
    echo "fuzzing $crate/$target for ${seconds}s"
    if ! (cd "$dir" && cargo fuzz run --sanitizer none "$target" "$store/corpus" -- \
        -max_total_time="$seconds" -artifact_prefix="$store/artifacts/" -print_final_stats=1); then
        failed+=("$crate/$target")
    fi
done

if [ ${#failed[@]} -gt 0 ]; then
    echo "crashes in: ${failed[*]} (inputs under $cache/<crate>/<target>/artifacts)"
    exit 1
fi
echo "all ${#targets[@]} targets ran ${seconds}s without a crash"
