#!/bin/bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
source=https://raw.githubusercontent.com/chromium/chromium/main/net/http/transport_security_state_static.json
target=$root/crates/web-net/data/hsts-preload.txt
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

curl -fsSL "$source" -o "$scratch/static.json"
python3 -I - "$scratch/static.json" "$scratch/list" <<'PYTHON'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as file:
    text = "\n".join(line for line in file.read().split("\n") if not line.lstrip().startswith("//"))
entries = json.loads(text)["entries"]
lines = sorted(
    f"{entry['name'].lower()}\t{'s' if entry.get('include_subdomains') else '-'}"
    for entry in entries
    if entry.get("mode") == "force-https" and entry.get("policy") != "test" and entry["name"].isascii()
)
with open(sys.argv[2], "w", encoding="ascii") as file:
    file.write("\n".join(lines) + "\n")
PYTHON
mkdir -p "$(dirname "$target")"
mv "$scratch/list" "$target"
echo "hsts-preload: $(wc -l < "$target") entries in $target"
