+void WaylandVsyncSource::ArmStallGuardLocked(
+    const MutexAutoLock& aProofOfLock) {
+  MOZ_DIAGNOSTIC_ASSERT(NS_IsMainThread());
+  mMutex.AssertCurrentThreadOwns();
+  if (mStallTimerID) {
+    return;
+  }
+  mStallTimerID = BandeTimeoutAdd(
+      uint32_t(mVsyncRate.ToMilliseconds() * 2) + 1,
+      [](void* data) -> bool {
+        RefPtr vsync = static_cast<WaylandVsyncSource*>(data);
+        return vsync->StallGuardCallback();
+      },
+      this);
+}
+
+bool WaylandVsyncSource::StallGuardCallback() {
+  MOZ_DIAGNOSTIC_ASSERT(NS_IsMainThread());
+  TimeStamp lastVSync;
+  TimeStamp outputTimestamp;
+  {
+    MutexAutoLock lock(mMutex);
+    const auto now = TimeStamp::Now();
+    if (!mVsyncEnabled || !mVsyncSourceEnabled || mIsShutdown ||
+        now - mLastVsyncTimeStamp < mVsyncRate * 2) {
+      mStallTimerID = 0;
+      return false;
+    }
+    LOG("WaylandVsyncSource::StallGuardCallback() no frame callback, emulate");
+    mLastVsyncTimeStamp = lastVSync = now;
+    outputTimestamp = now + mVsyncRate;
+  }
+  NotifyVsync(lastVSync, outputTimestamp);
+  return true;
+}
