+  showBandeLookUpItem() {
+    let item = this.window.document.getElementById("context-bande-lookup");
+    let word = this.isTextSelected ? this.selectedText.trim() : "";
+    item.hidden =
+      !word || word.length > 100 || this.onImage || !bandeLookUpInstalled();
+    if (item.hidden) {
+      return;
+    }
+    let shown = word.length > 30 ? word.slice(0, 30) + "\u2026" : word;
+    this.window.document.l10n.setAttributes(
+      item,
+      "main-context-menu-bande-look-up",
+      { word: shown }
+    );
+  }
+
+  bandeLookUp() {
+    let word = this.selectedText.trim();
+    lazy.Subprocess.call({ command: BANDE_LOOK_UP, arguments: [word] })
+      .then(process => process.wait())
+      .catch(console.error);
+  }
