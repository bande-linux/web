Ask for a search engine on first launch: no default until the user picks one

--- /dev/null
+++ firefox-esr-153.6.0esr/browser/base/content/bande-search-choice.js
@@ -0,0 +1,29 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+const { SearchService } = ChromeUtils.importESModule(
+  "moz-src:///toolkit/components/search/SearchService.sys.mjs"
+);
+
+document.mozSubdialogReady = new Promise(resolve =>
+  window.addEventListener("DOMContentLoaded", resolve, { once: true })
+).then(async () => {
+  document.getElementById("none").addEventListener("click", () => window.close());
+  const list = document.getElementById("engines");
+  for (const engine of await SearchService.getVisibleEngines()) {
+    if (engine.id.startsWith("wikipedia")) {
+      continue;
+    }
+    const button = document.createElement("button");
+    button.textContent = engine.name;
+    button.addEventListener("click", async () => {
+      await SearchService.setDefault(engine, SearchService.CHANGE_REASON.USER);
+      Services.prefs.setBoolPref("keyword.enabled", true);
+      window.close();
+    });
+    list.append(button);
+  }
+});
