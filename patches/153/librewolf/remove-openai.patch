From 8ca2d1361a3f0a36f71b7e692319b800cf5c11c8 Mon Sep 17 00:00:00 2001
From: celenity <celenity@celenity.dev>
Date: Wed, 4 Feb 2026 04:27:07 +0000
Subject: [PATCH] fix: Remove OpenAI backend

Removes the OpenAI backend from Mozilla's ML (machine learning) component.

Signed-off-by: celenity <celenity@celenity.dev>
---
 toolkit/components/aboutinference/content/aboutInference.js | 4 ++--
 toolkit/components/ml/content/EngineProcess.sys.mjs         | 2 +-
 toolkit/components/ml/content/backends/Pipeline.mjs         | 6 +++---
 toolkit/components/ml/jar.mn                                | 4 ++--
 toolkit/content/license.html                                | 2 +-
 5 files changed, 9 insertions(+), 9 deletions(-)

Index: firefox-esr-153.6.0esr/toolkit/components/aboutinference/content/aboutInference.js
===================================================================
--- firefox-esr-153.6.0esr.orig/toolkit/components/aboutinference/content/aboutInference.js
+++ firefox-esr-153.6.0esr/toolkit/components/aboutinference/content/aboutInference.js
@@ -379,7 +379,7 @@ const INFERENCE_PAD_PRESETS = {
     device: "cpu",
     backend: "onnx",
   },
-  openai: {
+/*  openai: {
     inputArgs: [
       {
         role: "system",
@@ -398,7 +398,7 @@ const INFERENCE_PAD_PRESETS = {
     apiKey: "ollama",
     baseURL: "http://localhost:11434/v1",
     backend: "openai",
-  },
+  }, */
 };
 
 const PREDEFINED = Object.keys(INFERENCE_PAD_PRESETS);
Index: firefox-esr-153.6.0esr/toolkit/components/ml/content/EngineProcess.sys.mjs
===================================================================
--- firefox-esr-153.6.0esr.orig/toolkit/components/ml/content/EngineProcess.sys.mjs
+++ firefox-esr-153.6.0esr/toolkit/components/ml/content/EngineProcess.sys.mjs
@@ -27,7 +27,7 @@ export const BACKENDS = Object.freeze({
   llamaCpp: "llama.cpp",
   bestLlama: "best-llama",
   bestOnnx: "best-onnx",
-  openai: "openai",
+//  openai: "openai",
   staticEmbeddings: "static-embeddings",
 });
 
Index: firefox-esr-153.6.0esr/toolkit/components/ml/content/backends/Pipeline.mjs
===================================================================
--- firefox-esr-153.6.0esr.orig/toolkit/components/ml/content/backends/Pipeline.mjs
+++ firefox-esr-153.6.0esr/toolkit/components/ml/content/backends/Pipeline.mjs
@@ -14,7 +14,7 @@ ChromeUtils.defineESModuleGetters(
     LlamaCppPipeline:
       "chrome://global/content/ml/backends/LlamaCppPipeline.mjs",
     PipelineOptions: "chrome://global/content/ml/EngineProcess.sys.mjs",
-    OpenAIPipeline: "chrome://global/content/ml/backends/OpenAIPipeline.mjs",
+//    OpenAIPipeline: "chrome://global/content/ml/backends/OpenAIPipeline.mjs",
     StaticEmbeddingsPipeline:
       "chrome://global/content/ml/backends/StaticEmbeddingsPipeline.mjs",
   },
@@ -50,9 +50,9 @@ export async function getBackend(consume
     case "llama.cpp":
       factory = lazy.LlamaCppPipeline.initialize;
       break;
-    case "openai":
+/*    case "openai":
       factory = lazy.OpenAIPipeline.initialize;
-      break;
+      break; */
     case "static-embeddings":
       factory = lazy.StaticEmbeddingsPipeline.initialize;
       break;
